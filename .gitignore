loop/tasks.db
loop/tasks.db-wal
loop/tasks.db-shm
loop/LOOP_STATUS.md
loop/.runner.lock
# Multi-lane run state (loop/lane.sh)
loop/.lane-pids
loop/.merge.lock/
loop/lane-*.log
loop/REPLAN-*.sh
loop/REPLAN-*.sh.applied
loop/REPLAN-*.sh.failed

# CloudKit server-to-server keys — never commit private keys
*.pem
*.p8
*.p12
eckey*
cloudkit-key*
