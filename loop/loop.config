# ===== PER-PROJECT ADAPTER — the ONLY file you edit when copying to a new project =====
PROJECT_NAME="Reflect"
WORK_BRANCH="develop"              # executors branch off this into feat/<TASK-ID>-<slug>, PRs target this

# Reflect is a single-lane iOS/Xcode project — one gate covers every task.
# grep for "error:" (per CLAUDE.md's build-and-verify rule); an empty grep plus
# a "** BUILD SUCCEEDED **" tail means green. Executors, reviewers, and mergers
# all run this same command before calling pr/approve/done respectively.
TEST_CMD="xcodebuild -project Reflect.xcodeproj -scheme Reflect -destination 'platform=iOS Simulator,name=iPhone 17' -configuration Debug build 2>&1 | grep \"error:\" ; echo \"---\"; xcodebuild -project Reflect.xcodeproj -scheme Reflect -destination 'platform=iOS Simulator,name=iPhone 17' -configuration Debug build 2>&1 | tail -5"
BUILD_CMD=""                       # folded into TEST_CMD above; nothing extra to run
# The plan doc currently being executed. Injected into every task/review/merge
# prompt by runner.sh, so templates never hardcode a feature's doc path — point
# this at the next plan and the whole kit follows.
PLAN_DOC="docs/features/multi-answer-ui-plan.md"
SPEC_ENTRY="CLAUDE.md $PLAN_DOC"
PROJECT_RULES="CLAUDE.md"          # workflow rules (branching/commit format/build gate), injected into every task prompt

# Models + turn caps per tier.
# trivial  = docs, constants, DI wiring, mechanical renames — no design judgement
# standard = one-feature-file work with a clear, already-decided spec  <- most tasks
# complex  = multi-file cutover others depend on (multi-answer plan: TASK-006, 009, 010, 013)
# architect / control = planner, replanner — design decisions
# review   = PR review gate; loads swiftui-pro/swiftdata-pro/swift-concurrency-pro as relevant to the diff
MODEL_TRIVIAL="haiku";   TURNS_TRIVIAL=15
MODEL_STANDARD="sonnet"; TURNS_STANDARD=40
MODEL_COMPLEX="sonnet";  TURNS_COMPLEX=80
MODEL_CONTROL="fable";   TURNS_CONTROL=60   # planner / replanner / architect
MODEL_REVIEW="sonnet";   TURNS_REVIEW=40    # PR review gate — raise to "fable" for stricter review if desired
TURNS_MERGE=15                              # merge tier always uses MODEL_TRIVIAL (mechanical: merge + verify)

# Stop dispatching and call the replanner after this many blocked tasks
export BLOCKED_REPLAN_THRESHOLD=2
